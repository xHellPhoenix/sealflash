{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SealFlash",
  "version": "0.4.1",
  "identifier": "io.github.xhellphoenix.sealflash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SealFlash",
        "width": 960,
        "height": 680,
        "minWidth": 820,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "USB-Boot-Sticks ohne ISO-Suche",
    "longDescription": "SealFlash lädt die neueste Version einer Linux-Distribution oder von Windows direkt von der offiziellen Quelle, prüft sie und schreibt sie auf einen USB-Stick.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 xHellPhoenix – GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/xHellPhoenix/sealflash"
  }
}
